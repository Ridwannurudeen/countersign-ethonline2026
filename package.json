{
  "name": "countersign",
  "version": "0.1.0",
  "private": true,
  "description": "Countersign validates consensus-resolved HBAR schedules against owner-signed mandates before adding the guard key.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build-evidence": "node --experimental-strip-types scripts/build-evidence.ts",
    "demo": "node --env-file-if-exists=.env --experimental-strip-types scripts/demo.ts",
    "hosted-review": "node --env-file-if-exists=var/hosted-caller.env --experimental-strip-types scripts/hosted-review.ts",
    "hts-purchase": "node --env-file-if-exists=.env --env-file-if-exists=var/hosted-caller.env --experimental-strip-types scripts/hts-purchase.ts",
    "provision-hosted": "node --env-file-if-exists=.env --experimental-strip-types scripts/provision-hosted.ts",
    "provision-sandbox": "node --env-file-if-exists=.env --experimental-strip-types scripts/provision-sandbox.ts",
    "refusal": "node --env-file-if-exists=.env --experimental-strip-types scripts/refusal.ts",
    "recurring-payments": "node --env-file-if-exists=var/sandbox.env --experimental-strip-types scripts/recurring-payments.ts",
    "serve-guard": "node --env-file-if-exists=var/hosted-guard.env --experimental-strip-types scripts/serve-guard.ts",
    "serve-sandbox": "node --env-file-if-exists=var/sandbox.env --experimental-strip-types scripts/serve-sandbox.ts",
    "sign-sandbox-mandates": "node --env-file-if-exists=var/sandbox.env --env-file-if-exists=var/sandbox-owner.env --experimental-strip-types scripts/sign-sandbox-mandates.ts",
    "spike": "node --env-file-if-exists=.env --experimental-strip-types scripts/spike-nested-key.ts",
    "test": "node --test --test-concurrency=1 --experimental-strip-types test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.85.0",
    "@x402/core": "2.25.0",
    "@x402/hedera": "2.25.0",
    "json-canonicalize": "3.0.0"
  },
  "overrides": {
    "@hiero-ledger/proto@2.31.0": {
      "protobufjs@8.0.1": "8.6.6"
    },
    "@hiero-ledger/sdk@2.85.0": {
      "@grpc/grpc-js@1.12.6": "1.12.7",
      "ethers": {
        "ws@8.17.1": "8.21.3"
      },
      "protobufjs@8.2.0": "8.6.6"
    }
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "typescript": "5.9.3"
  }
}
