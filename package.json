{
  "name": "countersign",
  "version": "0.1.0",
  "private": true,
  "description": "An AI can propose any transaction. It cannot execute one until an independent guard signs the exact bytes.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "spike": "node --experimental-strip-types scripts/spike-nested-key.ts"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.87.0"
  },
  "devDependencies": {
    "@types/node": "24.7.0",
    "typescript": "5.9.3"
  }
}
