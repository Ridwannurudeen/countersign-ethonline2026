# Existing funded Hedera testnet operator. Use a canonical numeric account ID.
HEDERA_OPERATOR_ACCOUNT_ID=

# DER-encoded Hedera private key for the operator above. Never commit the real value.
HEDERA_OPERATOR_PRIVATE_KEY=

# Exact major.minor.patch values independently recorded from NetworkVersionInfoQuery.
# On the first credentialed run, the spike prints the current values and stops here if
# these are unset. Record them, set both variables, then rerun the complete proof.
COUNTERSIGN_ALLOWED_PROTOBUF_VERSION=
COUNTERSIGN_ALLOWED_SERVICES_VERSION=
